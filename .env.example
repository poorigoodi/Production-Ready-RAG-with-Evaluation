APP_NAME=Advanced RAG Evaluation
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_PORT=8501
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
LOG_LEVEL=INFO

# Models (changing EMBEDDING_MODEL requires index rebuild)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional multilingual reranker: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LLM_MODEL=Qwen/Qwen3-1.7B
# Optional smaller LLM: Qwen/Qwen2.5-0.5B-Instruct
LLM_DEVICE=auto
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.1
# true = deterministic mock embeddings/reranker/LLM (no weight downloads; recommended first run)
MOCK_MODELS=true

CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_STRATEGY=paragraph

RETRIEVAL_MODE=hybrid
TOP_K=5
RRF_K=60
RERANK_CANDIDATES=20
ENABLE_RERANKING=true
ENABLE_QUERY_REWRITING=false

CONTEXT_MAX_TOKENS=2048
ANSWER_RESERVE_TOKENS=512
HISTORY_MAX_TURNS=6
MIN_RETRIEVAL_SCORE=0.05

DATABASE_URL=sqlite:///./data/rag.db
DOCUMENTS_DIR=./data/documents
INDEX_DIR=./data/indexes
EVALUATION_DIR=./data/evaluation
REPORTS_DIR=./reports

MAX_UPLOAD_SIZE_MB=20
